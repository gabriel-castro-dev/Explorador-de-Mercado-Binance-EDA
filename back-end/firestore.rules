rules_version = '2';

// Nenhum cliente (web/mobile) fala com o Firestore neste projeto: as
// preferencias sao lidas e escritas exclusivamente pela API FastAPI, que
// usa o Admin SDK (o Admin SDK ignora estas regras por design).
//
// Deny-all garante que uma web API key vazada nao exponha dados de usuario.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
