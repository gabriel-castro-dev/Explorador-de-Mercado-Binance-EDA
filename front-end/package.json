{
  "name": "crypto-forecasting-front-end",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ./openapi/openapi.json -o ./app/types/openapi.d.ts --alphabetize",
    "api:types:check": "pnpm api:types && git diff --exit-code -- app/types/openapi.d.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "lightweight-charts": "^5.2.1",
    "nuxt": "^4.5.2",
    "openapi-fetch": "^0.17.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  },
  "packageManager": "pnpm@11.22.0"
